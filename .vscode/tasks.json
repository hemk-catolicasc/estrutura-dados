{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "criar pasta bin",
            "command": "mkdir",
            "args": ["-p", "${workspaceFolder}/bin"],
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build active file",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}/bin/${fileBasenameNoExtension}",
                "-ansi",
                "-pedantic",
                "-Wall"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "criar pasta bin",
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila o arquivo aberto em bin/, fora do controle de versão."
        }
    ]
}
